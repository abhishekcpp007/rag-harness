# Which embedding backend to use: hash | fastembed | openai
RAG_EMBEDDER=hash
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Which answer generator: extractive | anthropic | openai
RAG_LLM=extractive
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

RAG_CORPUS_DIR=corpus
RAG_DB_PATH=data/index.sqlite3

# Retrieval. The defaults are the ones the README table argues for.
RAG_USE_SPARSE=0
RAG_EXPANSION=prf
RAG_PRF_DOCS=3
RAG_PRF_BETA=0.4

# Final pass: none | lexical | cross | cross+lexical
# Anything starting with cross downloads a model and costs roughly 100x the latency. The
# by-kind table says it also ranks worse on this corpus, so measure before switching.
RAG_RERANK=lexical
RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_RERANK_CANDIDATES=20

# Service. Logs are one JSON object per line, which is what a container log driver wants; set
# text when a human is tailing them.
RAG_LOG_FORMAT=json

# Rate limit per client, off at 0. Leave it off behind a gateway that already does this, and
# remember that switching it on means bench/load.py is measuring the limiter.
RAG_RATE_LIMIT_RPS=0
RAG_RATE_LIMIT_BURST=20
